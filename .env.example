# "groq" (free tier) or "openai" (paid)
LLM_PROVIDER=groq
GROQ_API_KEY=
# OPENAI_API_KEY=
# Leave empty for the provider's default (openai/gpt-oss-120b on Groq, gpt-5-mini on OpenAI)
# LLM_MODEL=
# Models to try when the main one hits its rate limit (default on Groq: openai/gpt-oss-20b; empty turns it off)
# LLM_FALLBACK_MODELS=

# Voice. Any American English Kokoro voice (af_heart by default; others: af_bella, am_michael, ...)
# TTS_VOICE=af_heart
# TTS_SPEED=1.05
# How long a pause ends the caller's turn
# VAD_MIN_SILENCE_MS=600
# How long the caller must talk over Sofia to interrupt her
# BARGE_IN_MS=300
# Per-turn timings, one JSON line each ("" turns it off)
# VOICE_TURN_LOG=data/voice-turns.jsonl

# Guardrails (NeMo, on Groq): screen what the caller says and what Sofia says. Needs GROQ_API_KEY
# GUARDRAILS_ENABLED=true
# The model that judges each turn and sentence
# GUARD_MODEL=qwen/qwen3.8-27b
# Meta's jailbreak classifier, and the attack probability it must reach to block
# PROMPT_GUARD_MODEL=meta-llama/llama-prompt-guard-2-86m
# PROMPT_GUARD_THRESHOLD=0.5
# Let a turn through when a check fails (a 429, mostly) instead of refusing it
# GUARDRAILS_FAIL_OPEN=true

# Origins the web app is served from (JSON list)
# CORS_ORIGINS=["http://localhost:5173"]
