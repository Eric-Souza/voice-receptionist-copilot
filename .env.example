# "groq" (free tier) or "openai" (paid)
LLM_PROVIDER=groq
GROQ_API_KEY=
# OPENAI_API_KEY=
# Leave empty for the provider's default (openai/gpt-oss-120b on Groq, gpt-5-mini on OpenAI)
# LLM_MODEL=
# Models to try when the main one hits its rate limit (default on Groq: openai/gpt-oss-20b; empty turns it off)
# LLM_FALLBACK_MODELS=

# Voice. Any American English Kokoro voice (af_heart by default; others: af_bella, am_michael, ...)
# TTS_VOICE=af_heart
# TTS_SPEED=1.05
# How long a pause ends the caller's turn
# VAD_MIN_SILENCE_MS=600
# How long the caller must talk over Sofia to interrupt her
# BARGE_IN_MS=300
# Per-turn timings, one JSON line each ("" turns it off)
# VOICE_TURN_LOG=data/voice-turns.jsonl

# Origins the web app is served from (JSON list)
# CORS_ORIGINS=["http://localhost:5173"]
